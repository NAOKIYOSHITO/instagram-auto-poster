# === Google スプレッドシート関連 ===
# サービスアカウントのメールアドレス（Google Cloud Consoleで発行）
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# サービスアカウントの秘密鍵（JSONキーの private_key の値をそのまま貼り付ける）
# 改行は \n のままでOK（コード側で復元します）
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxxxxxxxxxxxxx\n-----END PRIVATE KEY-----\n"

# スプレッドシートのID（URLの https://docs.google.com/spreadsheets/d/【ここ】/edit の部分）
GOOGLE_SHEET_ID=your-spreadsheet-id

# === Instagram / Facebook 関連 ===
# Meta for Developers で作成したアプリのApp IDとApp Secret（長期トークンの自動更新に使用）
IG_APP_ID=your-facebook-app-id
IG_APP_SECRET=your-facebook-app-secret

# === 画像自動生成（任意） ===
# 「投稿タイプ=image」かつ「メディアURL」が空欄の行は、キャプションの文章から
# OpenAIで画像を自動生成し、GitHubリポジトリのmedia/フォルダへ自動コミットします。
# 使わない場合はこのセクションは空のままでOKです。

# OpenAIのAPIキー（platform.openai.comで発行）
OPENAI_API_KEY=

# 画像のコミット先。GitHub Actions実行時は自動設定されるためローカル試用時のみ指定します。
# GITHUB_TOKEN: 対象リポジトリへの Contents: Read and write 権限を持つPersonal Access Token
# GITHUB_REPO : "owner/repo" 形式
# GITHUB_BRANCH: コミット先ブランチ（省略時は main）
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=
